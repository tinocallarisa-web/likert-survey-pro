{
  "dataRoles": [
    {
      "displayName": "Question",
      "displayNameKey": "Role_Question",
      "name": "question",
      "kind": "Grouping",
      "description": "One diverging bar per value: the survey question or item. Put a hierarchy here to drill down.",
      "descriptionKey": "Role_Question_Desc"
    },
    {
      "displayName": "Response",
      "displayNameKey": "Role_Response",
      "name": "response",
      "kind": "Grouping",
      "description": "The scale point (Strongly disagree … Strongly agree). Use the Scale order well, or sort this column in the model, to control the order of the scale.",
      "descriptionKey": "Role_Response_Desc"
    },
    {
      "displayName": "Value",
      "displayNameKey": "Role_Value",
      "name": "value",
      "kind": "Measure",
      "description": "Count of responses, or any measure to distribute across the scale.",
      "descriptionKey": "Role_Value_Desc"
    },
    {
      "displayName": "Scale order",
      "displayNameKey": "Role_Order",
      "name": "order",
      "kind": "Measure",
      "description": "Optional numeric rank for each scale point (1 = leftmost). Use it when the response column is not sorted in the model: without a defined order the scale is meaningless.",
      "descriptionKey": "Role_Order_Desc"
    },
    {
      "displayName": "Group [Pro]",
      "displayNameKey": "Role_Group",
      "name": "group",
      "kind": "Grouping",
      "description": "Optional block that questions belong to, rendered as a labelled section.",
      "descriptionKey": "Role_Group_Desc"
    },
    {
      "displayName": "Small multiples (Pro)",
      "displayNameKey": "Role_Panel",
      "name": "panel",
      "kind": "Grouping",
      "description": "One Likert chart per value (region, year, team), sharing the same questions and scale.",
      "descriptionKey": "Role_Panel_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "response": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "order": {
            "max": 1
          },
          "group": {
            "max": 1
          },
          "panel": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "group"
              }
            },
            {
              "for": {
                "in": "question"
              }
            },
            {
              "for": {
                "in": "panel"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "response",
            "select": [
              {
                "bind": {
                  "to": "value"
                }
              },
              {
                "bind": {
                  "to": "order"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 30
              }
            }
          }
        }
      }
    }
  ],
