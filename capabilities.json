{
  "dataRoles": [
    {
      "displayName": "Question",
      "displayNameKey": "Role_Question",
      "name": "question",
      "kind": "Grouping",
      "description": "One diverging bar per value: the survey question or item."
    },
    {
      "displayName": "Response",
      "displayNameKey": "Role_Response",
      "name": "response",
      "kind": "Grouping",
      "description": "The scale point (Strongly disagree … Strongly agree). Use the Scale order well, or sort this column in the model, to control the order of the scale."
    },
    {
      "displayName": "Value",
      "displayNameKey": "Role_Value",
      "name": "value",
      "kind": "Measure",
      "description": "Count of responses, or any measure to distribute across the scale."
    },
    {
      "displayName": "Scale order",
      "displayNameKey": "Role_Order",
      "name": "order",
      "kind": "Measure",
      "description": "Optional numeric rank for each scale point (1 = leftmost). Use it when the response column is not sorted in the model: without a defined order the scale is meaningless."
    },
    {
      "displayName": "Group [Pro]",
      "displayNameKey": "Role_Group",
      "name": "group",
      "kind": "Grouping",
      "description": "Optional block that questions belong to, rendered as a labelled section."
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "question": {
            "max": 1
          },
          "response": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "order": {
            "max": 1
          },
          "group": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "group"
              }
            },
            {
              "for": {
                "in": "question"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "response",
            "select": [
              {
                "bind": {
                  "to": "value"
                }
              },
              {
                "bind": {
                  "to": "order"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 30
              }
            }
          }
        }
      }
    }
  ],
  "objects": {
    "scale": {
      "displayName": "Scale",
      "displayNameKey": "Obj_Scale",
      "properties": {
        "negativeCount": {
          "displayName": "Negative points",
          "displayNameKey": "Prop_ScaleNegativeCount",
          "description": "How many scale points from the left count as negative. The rest are positive, minus the neutral one if it is set apart.",
          "type": {
            "numeric": true
          }
        },
        "neutralMode": {
          "displayName": "Neutral point",
          "displayNameKey": "Prop_ScaleNeutralMode",
          "type": {
            "enumeration": [
              {
                "value": "split",
                "displayName": "Split across the centre"
              },
              {
                "value": "right",
                "displayName": "Count as positive"
              },
              {
                "value": "exclude",
                "displayName": "Leave out of the bar"
              }
            ]
          }
        },
        "asPercent": {
          "displayName": "Show as percentage",
          "displayNameKey": "Prop_ScaleAsPercent",
          "type": {
            "bool": true
          }
        }
      }
    },
    "colors": {
      "displayName": "Colors",
      "displayNameKey": "Obj_Colors",
      "properties": {
        "negativeColor": {
          "displayName": "Negative end",
          "displayNameKey": "Prop_ColorsNegativeColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "positiveColor": {
          "displayName": "Positive end",
          "displayNameKey": "Prop_ColorsPositiveColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "neutralColor": {
          "displayName": "Neutral",
          "displayNameKey": "Prop_ColorsNeutralColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "fill": {
          "displayName": "Scale point",
          "displayNameKey": "Prop_ColorsFill",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "qtable": {
      "displayName": "Question table",
      "displayNameKey": "Obj_Qtable",
      "properties": {
        "blockWidth": {
          "displayName": "Block column width (%)",
          "displayNameKey": "Prop_QtableBlockWidth",
          "description": "Width of the block column, as a share of the visual. The column disappears when no field is in the Group well.",
          "type": {
            "numeric": true
          }
        },
        "blockFill": {
          "displayName": "Shade each block",
          "displayNameKey": "Prop_QtableBlockFill",
          "description": "Gives every block its own tinted background, so the sections read as a table rather than as floating labels.",
          "type": {
            "bool": true
          }
        },
        "blockOpacity": {
          "displayName": "Shading strength (%)",
          "displayNameKey": "Prop_QtableBlockOpacity",
          "type": {
            "numeric": true
          }
        },
        "blockFillColor": {
          "displayName": "Block color",
          "displayNameKey": "Prop_QtableBlockFillColor",
          "description": "Colour of a block's background. Left alone it takes the report theme. With a licence it also accepts a rule (fx) over a measure, turning the block column into a small heatmap.",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "blockFontFamily": {
          "displayName": "Block font",
          "displayNameKey": "Prop_QtableBlockFontFamily",
          "type": {
            "formatting": {
              "fontFamily": true
            }
          }
        },
        "blockFontSize": {
          "displayName": "Block text size",
          "displayNameKey": "Prop_QtableBlockFontSize",
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "blockColor": {
          "displayName": "Block text color",
          "displayNameKey": "Prop_QtableBlockColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "questionAlign": {
          "displayName": "Question alignment",
          "displayNameKey": "Prop_QtableQuestionAlign",
          "type": {
            "enumeration": [
              {
                "value": "left",
                "displayName": "Left"
              },
              {
                "value": "right",
                "displayName": "Right"
              }
            ]
          }
        },
        "questionFontFamily": {
          "displayName": "Question font",
          "displayNameKey": "Prop_QtableQuestionFontFamily",
          "type": {
            "formatting": {
              "fontFamily": true
            }
          }
        },
        "questionFontSize": {
          "displayName": "Question text size",
          "displayNameKey": "Prop_QtableQuestionFontSize",
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "questionColor": {
          "displayName": "Question text color",
          "displayNameKey": "Prop_QtableQuestionColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "separator": {
          "displayName": "Line between blocks",
          "displayNameKey": "Prop_QtableSeparator",
          "type": {
            "bool": true
          }
        }
      }
    },
    "labels": {
      "displayName": "Labels",
      "displayNameKey": "Obj_Labels",
      "properties": {
        "showValues": {
          "displayName": "Show values on segments",
          "displayNameKey": "Prop_LabelsShowValues",
          "type": {
            "bool": true
          }
        },
        "minSegment": {
          "displayName": "Hide labels under (%)",
          "displayNameKey": "Prop_LabelsMinSegment",
          "type": {
            "numeric": true
          }
        },
        "decimals": {
          "displayName": "Decimal places",
          "displayNameKey": "Prop_LabelsDecimals",
          "type": {
            "numeric": true
          }
        },
        "questionWidth": {
          "displayName": "Question column width (%)",
          "displayNameKey": "Prop_LabelsQuestionWidth",
          "description": "Maximum width of the question column. The column shrinks to fit the longest question, so short questions leave no dead space.",
          "type": {
            "numeric": true
          }
        },
        "labelGap": {
          "displayName": "Gap to the bars (px)",
          "displayNameKey": "Prop_LabelsLabelGap",
          "type": {
            "numeric": true
          }
        },
        "fontSize": {
          "displayName": "Text size",
          "displayNameKey": "Prop_LabelsFontSize",
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "textColor": {
          "displayName": "Text color",
          "displayNameKey": "Prop_LabelsTextColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "boxes": {
      "displayName": "Top / Bottom box [Pro]",
      "displayNameKey": "Obj_Boxes",
      "properties": {
        "show": {
          "displayName": "Show Top/Bottom box",
          "displayNameKey": "Prop_BoxesShow",
          "type": {
            "bool": true
          }
        },
        "size": {
          "displayName": "Box size",
          "displayNameKey": "Prop_BoxesSize",
          "type": {
            "enumeration": [
              {
                "value": "1",
                "displayName": "Top-1 / Bottom-1"
              },
              {
                "value": "2",
                "displayName": "Top-2 / Bottom-2"
              },
              {
                "value": "3",
                "displayName": "Top-3 / Bottom-3"
              }
            ]
          }
        },
        "showNps": {
          "displayName": "Show NPS (Top − Bottom)",
          "displayNameKey": "Prop_BoxesShowNps",
          "type": {
            "bool": true
          }
        }
      }
    },
    "benchmark": {
      "displayName": "Benchmark [Pro]",
      "displayNameKey": "Obj_Benchmark",
      "properties": {
        "show": {
          "displayName": "Show benchmark line",
          "displayNameKey": "Prop_BenchmarkShow",
          "type": {
            "bool": true
          }
        },
        "value": {
          "displayName": "Positive share (%)",
          "displayNameKey": "Prop_BenchmarkValue",
          "type": {
            "numeric": true
          }
        },
        "color": {
          "displayName": "Line color",
          "displayNameKey": "Prop_BenchmarkColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "layout": {
      "displayName": "Layout",
      "displayNameKey": "Obj_Layout",
      "properties": {
        "enableScroll": {
          "displayName": "Scroll when rows do not fit",
          "displayNameKey": "Prop_LayoutEnableScroll",
          "description": "On, rows keep a readable height and the chart scrolls. Off, rows shrink so everything fits — useful when the report is exported to PDF or PowerPoint, where only the visible part is captured.",
          "type": {
            "bool": true
          }
        },
        "minRowHeight": {
          "displayName": "Minimum row height (px)",
          "displayNameKey": "Prop_LayoutMinRowHeight",
          "type": {
            "numeric": true
          }
        },
        "segmentGap": {
          "displayName": "Gap between scale points (px)",
          "displayNameKey": "Prop_LayoutSegmentGap",
          "description": "Separation drawn between the stacked segments. The gap is skipped on segments too narrow to survive it, so small shares never disappear.",
          "type": {
            "numeric": true
          }
        },
        "rowGap": {
          "displayName": "Gap between rows (px)",
          "displayNameKey": "Prop_LayoutRowGap",
          "description": "Vertical separation between bars. At 0 the bars fill the row and touch each other; raise it to give them air.",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "legend": {
      "displayName": "Legend",
      "displayNameKey": "Obj_Legend",
      "properties": {
        "show": {
          "displayName": "Show legend",
          "displayNameKey": "Prop_LegendShow",
          "type": {
            "bool": true
          }
        },
        "position": {
          "displayName": "Position",
          "displayNameKey": "Prop_LegendPosition",
          "type": {
            "enumeration": [
              {
                "value": "top",
                "displayName": "Top"
              },
              {
                "value": "bottom",
                "displayName": "Bottom"
              }
            ]
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "sorting": {
    "default": {}
  },
  "supportsHighlight": true,
  "supportsSynchronizingFilterState": true,
  "supportsLandingPage": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true,
  "privileges": []
}
